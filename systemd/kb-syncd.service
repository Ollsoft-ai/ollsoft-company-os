[Unit]
Description=KB sync daemon (CRDT relay + filesystem merge)
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/kb/kb.env
Environment=PYTHONPATH=/opt/kb-platform
Environment=KB_REPO=/srv/kb
Environment=KB_RUN=/run/kb
Environment=KB_ETC=/etc/kb
ExecStart=/opt/kb-venv/bin/python -m kb_platform.syncd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
