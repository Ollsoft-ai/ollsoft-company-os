[Unit]
Description=KB: anonymous usage ping (version, size, platform)
# What it sends is listed in full in docs/telemetry.md and printed verbatim by
# `kb-telemetry show`. No hostname, no IP, no account names, nothing from the
# knowledgebase. KB_TELEMETRY=off in /etc/kb/kb.env stops it; the script checks
# that on every run, so switching it off needs no systemctl.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/kb/kb.env
ExecStart=/opt/kb-platform/scripts/kb-telemetry ping
Nice=19
IOSchedulingClass=idle
# A ping is never worth a failed unit in anybody's status output.
SuccessExitStatus=0 1
