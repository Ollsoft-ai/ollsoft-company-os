[Unit]
Description=KB convert (office/pdf -> hidden read-only markdown sidecars)
After=network.target

OnFailure=kb-alert@%n.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=kbindexer
EnvironmentFile=-/etc/kb/kb.env
Environment=PYTHONPATH=/opt/kb-platform
Environment=KB_REPO=/srv/kb
Environment=KB_RUN=/run/kb
Environment=KB_ETC=/etc/kb
# Its own venv: the document parsers are heavy and version-churny, and have no
# business inside the platform venv. Created by scripts/install.sh from
# requirements-convert.txt.
ExecStart=/opt/kb-convert-venv/bin/python -m kb_platform.convert
Restart=on-failure
RestartSec=3
# Parsing a fat pptx is the one CPU/RAM-hungry thing on this box — keep it polite.
Nice=10
MemoryMax=2G
# Each document is parsed in a short-lived child (kb_platform.convert_extract)
# precisely so that blowing this budget kills the parse and not the service.
# systemd's default OOMPolicy=stop would undo that: it treats *any* process in
# the cgroup being OOM-killed as the unit failing, which is exactly the
# 15-minute crash loop this design exists to end.
OOMPolicy=continue

[Install]
WantedBy=multi-user.target
